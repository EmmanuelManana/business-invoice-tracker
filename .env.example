# Copy to .env to override the docker-compose defaults. Never commit .env.
# All values below are examples for local use. Generate real secrets for any shared environment,
# e.g.  openssl rand -base64 48

# --- Database -------------------------------------------------------------------------------
POSTGRES_DB=invoice_tracker
POSTGRES_USER=invoice_tracker
POSTGRES_PASSWORD=change-me

# --- API security ---------------------------------------------------------------------------
# HS256 signing key for access tokens. At least 32 bytes.
APP_AUTH_JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# true behind HTTPS (production); false only for plain-HTTP localhost.
APP_AUTH_COOKIE_SECURE=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Overdue job ----------------------------------------------------------------------------
# How often the overdue/reminder job runs (ISO-8601 duration).
APP_OVERDUE_INTERVAL=PT1M
# Days relative to the due date when reminders go out.
APP_REMINDERS_OFFSETS_DAYS=-3,0,1,7,14
APP_REMINDERS_SMS_ENABLED=true

# --- Demo features (disable outside local/demo environments) --------------------------------
APP_DEV_TOOLS_ENABLED=true
APP_SEED_ENABLED=true
APP_SEED_DEMO_EMAIL=demo@acme.co.za
APP_SEED_DEMO_PASSWORD=Demo@12345

# --- Published ports ------------------------------------------------------------------------
API_PORT=8080
WEB_PORT=3000
